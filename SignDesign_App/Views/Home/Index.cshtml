@using SignDesign_App.Models;
@using Microsoft.AspNetCore.Identity;
@inject UserManager<ApplicationUser> userManager;
@inject SignInManager<ApplicationUser> SignInManager;

@{
    ViewData["Title"] = "Home Page";
}

<div class="p-4">
    <br />
    <h2 style="text-align:center">CORPUS CHRISTI DISTRICT</h2>
    <h4 style="text-align:center">SIGN MANAGEMENT</h4>
    <br/>
    <br />
    <img class="center" src="~/Images/txdotBanner4.png" width=70% />
    <br />
    <br />
    <br />
    @if (!SignInManager.IsSignedIn(User))
    {
        <form method="get" asp-action="Login" asp-controller="Identity">
            <button type="submit" class="btn btn-dark center-button-css-signin">ENTER</button>
        </form>
    }
    @if (SignInManager.IsSignedIn(User))
    {
        <h2 style="text-align:center">WELCOME!</h2>
    }
</div>